<?xml version="1.0" encoding="utf-8"?>
<!--
    Backup and device-transfer rules for Android 12+. Same policy as backup_rules.xml: user data
    (user_data.db with favorites) travels with the user, and the TMDB cache doesn't.
    See https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="movie_cache.db" />
        <exclude domain="database" path="movie_cache.db-shm" />
        <exclude domain="database" path="movie_cache.db-wal" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="movie_cache.db" />
        <exclude domain="database" path="movie_cache.db-shm" />
        <exclude domain="database" path="movie_cache.db-wal" />
    </device-transfer>
</data-extraction-rules>
